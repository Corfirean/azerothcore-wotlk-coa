# =====================================================================
# Multi-Realm Automated Test Suite — Environment Configuration Example
# Copy this file to .env or set environment variables before running tests.
# NEVER commit .env with real credentials to source control!
# =====================================================================

# MySQL Connection Settings
COA_TEST_MYSQL_HOST=127.0.0.1
COA_TEST_MYSQL_PORT=43319
COA_TEST_MYSQL_USER=root
COA_TEST_MYSQL_PASS=your_local_mysql_password_here
COA_TEST_MYSQL_EXE=C:\games\CoA Server 2\mysql\bin\mysql.exe

# Remote Administration (RA) Settings
COA_TEST_RA_HOST=127.0.0.1
COA_TEST_RA_PORT=3469
COA_TEST_RA_USER=TESTER
COA_TEST_RA_PASS=your_test_ra_password_here

# Paths
COA_TEST_DATA_DIR=C:\games\CoA Server 2\Data
COA_TEST_CONFIG_SRC_DIR=C:\games\source\training-arena\.agents\training-live\play-server-runtime\configs
COA_TEST_SERVER_EXE=C:\games\source\multirealm-core\build\bin\worldserver.exe
